{
  "name": "yueswater-blog",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "hexo": {
    "version": "8.1.2"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:ocean": "esbuild tools/ascii-ocean/ascii-sharks/entry.ts --bundle --minify --format=iife --target=es2019 --outfile=themes/Chic/source/js/widgets/ascii-ocean.js",
    "build:contact": "esbuild tools/contact-editor/index.js --bundle --minify --format=esm --target=es2020 --outfile=themes/Chic/source/js/widgets/contact/editor.bundle.js",
    "test:contact:unit": "node --test tests/contact/unit/",
    "test:contact:e2e": "playwright test -c tests/contact/playwright.config.js",
    "test:security:e2e": "playwright test -c tests/security/playwright.config.js",
    "test:security:db": "node --test --test-concurrency=1 --test-reporter=./tests/security/reporters/progress.mjs tests/security/db/",
    "test:security": "npm run -s test:security:e2e; e=$?; npm run -s test:security:db || e=1; exit $e",
    "test:reply:unit": "node --test tests/contact-reply/unit/",
    "test:reply:e2e": "playwright test -c tests/contact-reply/playwright.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yueswater/yueswater-blog.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yueswater/yueswater-blog/issues"
  },
  "homepage": "https://github.com/yueswater/yueswater-blog#readme",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mathjax/mathjax-pagella-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "clipboard": "^2.0.11",
    "hexo": "^8.1.2",
    "hexo-admonition-new": "^2.0.1",
    "hexo-cli": "^4.3.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-pagination": "^4.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-kramed": "^0.1.4",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "highlightjs-typst": "^0.1.3",
    "pinyin": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-code-block-lowlight": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-mathematics": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "esbuild": "^0.28.2",
    "hexo-browsersync": "^0.3.0",
    "katex": "0.18.11",
    "lowlight": "3.3.0",
    "simple-icons": "^16.28.0"
  }
}
