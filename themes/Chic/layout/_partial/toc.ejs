<div class="post-toc">
    <div class="tocbot-list">
    </div>
    <div class="tocbot-list-menu">
        <a class="tocbot-toc-expand" onclick="expand_toc()"><%= __('expand_all') %></a>
        <a onclick="go_top()"><%= __('back_to_top') %></a>
        <a onclick="go_bottom()"><%= __('go_to_bottom') %></a>
    </div>
</div>

<script>
    var TOC_EXPAND_ALL_TEXT = '<%- __('expand_all') %>';
    var TOC_COLLAPSE_ALL_TEXT = '<%- __('collapse_all') %>';
    var tocbot_timer;
    var DEPTH_MAX = 6; // 为 6 时展开所有
    var tocbot_default_config = {
        tocSelector: '.tocbot-list',
        contentSelector: '.post-content',
        headingSelector: 'h1, h2, h3, h4, h5',
        ignoreSelector: '.no-toc',
        orderedList: false,
        scrollSmooth: true,
        onClick: extend_click,
    };

    // Post-process every TOC entry tocbot just built, matched back to its
    // source heading via the entry's #id link:
    //   - a heading with class="no-toc" (headings inside a
    //     ::: {.problem} ... ::: block, e.g. "#### Example 1" -- see
    //     problemDiv.js) gets its whole <li> removed from the sidebar.
    //     tocbot's own ignoreSelector option is meant to do this via its
    //     heading query, but we don't rely on it -- excluding tocbot.min.js's
    //     minified internals from the trust boundary and enforcing this
    //     ourselves is simpler to reason about and verify.
    //   - a heading tagged data-toc="..." (see tocShortTitle.js) shows that
    //     short label instead of its own full text -- LaTeX's
    //     \section[short]{long}, since tocbot otherwise always copies a
    //     heading's own text verbatim.
    // Re-applied after every tocbot.init/refresh, since each rebuilds the
    // sidebar from scratch.
    function apply_toc_overrides() {
        document.querySelectorAll('.tocbot-list a').forEach(function(a) {
            var href = a.getAttribute('href') || '';
            if (href.charAt(0) !== '#') return;
            var heading = document.getElementById(decodeURIComponent(href.slice(1)));
            if (!heading) return;
            if (heading.classList.contains('no-toc')) {
                var li = a.closest('li');
                if (li) li.remove();
            } else if (heading.dataset.toc) {
                a.textContent = heading.dataset.toc;
            }
        });
    }

    function extend_click() {
        clearTimeout(tocbot_timer);
        tocbot_timer = setTimeout(function() {
            tocbot.refresh(obj_merge(tocbot_default_config, {
                hasInnerContainers: true
            }));
            requestAnimationFrame(apply_toc_overrides);
        }, 420); // 这个值是由 tocbot 源码里定义的 scrollSmoothDuration 得来的
    }

    document.ready(function() {
        tocbot.init(obj_merge(tocbot_default_config, {
            collapseDepth: 1
        }));
        requestAnimationFrame(apply_toc_overrides);
    });

    function expand_toc() {
        var b = document.querySelector('.tocbot-toc-expand');
        var expanded = b.getAttribute('data-expanded');
        expanded ? b.removeAttribute('data-expanded') : b.setAttribute('data-expanded', true);
        tocbot.refresh(obj_merge(tocbot_default_config, {
            collapseDepth: expanded ? 1 : DEPTH_MAX
        }));
        requestAnimationFrame(apply_toc_overrides);
        b.innerText = expanded ? TOC_EXPAND_ALL_TEXT : TOC_COLLAPSE_ALL_TEXT;
    }

    function go_top() {
        window.scrollTo(0, 0);
    }

    function go_bottom() {
        window.scrollTo(0, document.body.scrollHeight);
    }

    function obj_merge(target, source) {
        for (var item in source) {
            if (source.hasOwnProperty(item)) {
                target[item] = source[item];
            }
        }
        return target;
    }
</script>