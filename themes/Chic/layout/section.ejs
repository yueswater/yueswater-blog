<div class="container">
    <div class="post-wrap section-list">
        <h2 class="post-title"><%- page.title %></h2>
        <div class="section-posts">
            <% page.posts.forEach(function (post) { %>
                <a class="section-post-item" href="<%- url_for(post.path) %>">
                    <% if (post.thumbnail) { %>
                        <div class="section-post-thumb">
                            <img src="<%- url_for(post.thumbnail) %>" alt="">
                        </div>
                    <% } %>
                    <div class="section-post-body">
                        <h3 class="section-post-title"><%= post.title %></h3>
                        <% if (post.excerpt) { %>
                            <p class="section-post-excerpt"><%= post.excerpt %></p>
                        <% } %>
                    </div>
                </a>
            <% }) %>
        </div>
        <%- partial('_partial/paginator') %>
    </div>
</div>
