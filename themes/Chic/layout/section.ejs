<%
    // pagehead.<id>.* strings are keyed by the section's url segment (articles, projects, diary...)
    var secId = String(page.section_prefix || '').replace(/\/$/, '');
%>
<%- partial('_partial/pagehead', {
    kicker: __('pagehead.' + secId + '.kicker'),
    title: title_html(page.title),
    lead: __('pagehead.' + secId + '.lead', page.total_posts),
    label: __('pagehead.' + secId + '.label'),
    big: page.total_posts
}) %>
<div class="container container--bleed">
    <div class="post-wrap post-wrap--wide section-list">
        <% if (page.posts.length === 0) { %>
            <p class="section-empty"><%= __('no_posts_yet') %></p>
        <% } else { %>
            <%- partial('_partial/post-rows', { posts: page.posts, year_counts: page.year_counts }) %>
        <% } %>
        <%- partial('_partial/paginator') %>
    </div>
</div>
