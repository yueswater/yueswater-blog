<!-- MathJax 4, TeX Gyre Pagella math font. $...$ inline, $$...$$ display -->
<script>
    window.MathJax = {
        tex: {
            inlineMath: [["$", "$"], ["\\(", "\\)"]],
            processEscapes: true,
            tags: "ams"
        },
        options: {
            ignoreHtmlClass: "tex2jax_ignore|dno",
            skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"],
            // no right-click menu and none of the accessibility overlays (the focus box
            // with its info icon, collapsible sub-expressions): double-click copies the
            // LaTeX instead, see js/post/math-copy.js.
            // The enable* options alone are overwritten at startup from the menu's
            // default settings, so those defaults are switched off as well.
            enableMenu: false,
            menuOptions: {
                settings: {
                    enrich: false,
                    speech: false,
                    braille: false,
                    collapsible: false,
                    assistiveMml: false,
                    inTabOrder: false,
                    help: false
                }
            }
        },
        output: {
            font: "mathjax-pagella"
        },
        startup: {
            pageReady: function () {
                // kramed turns $$...$$ into MathJax 2's <script type="math/tex"> tags, which
                // MathJax 4 ignores: put the source back as plain delimited text first
                document.querySelectorAll('script[type^="math/tex"]').forEach(function (el) {
                    var display = /mode=display/.test(el.type);
                    var holder = document.createElement(display ? "div" : "span");
                    holder.textContent = display ? "\\[" + el.text + "\\]" : "\\(" + el.text + "\\)";
                    el.parentNode.replaceChild(holder, el);
                });
                // @eq:id gives <span class="eq-ref" data-eq="id">式 $\eqref{id}$</span>; MathJax's
                // own link would cover only "(1)", so the whole span becomes one link to the
                // target MathJax names mjx-eqn:<id>. (Done before typesetting: the promise
                // below is not a reliable "finished" signal.)
                document.querySelectorAll("span.eq-ref").forEach(function (span) {
                    var link = document.createElement("a");
                    link.className = "eq-ref";
                    link.href = "#" + encodeURIComponent("mjx-eqn:" + span.getAttribute("data-eq"));
                    while (span.firstChild) link.appendChild(span.firstChild);
                    span.parentNode.replaceChild(link, span);
                });
                return MathJax.startup.defaultPageReady().then(function () {
                    // kept from the 2.x config: mark each formula's parent
                    document.querySelectorAll("mjx-container").forEach(function (el) {
                        if (el.parentNode) el.parentNode.classList.add("has-jax");
                    });
                });
            }
        }
    };
</script>
<script async src="https://cdn.jsdelivr.net/npm/mathjax@4.1.3/tex-chtml.js"></script>
