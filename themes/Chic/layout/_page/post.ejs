<%
    var secMatch = String(page.path).replace(/^\//, '').split('/')[0].replace(/-en$/, '');
    var section = ['articles', 'projects', 'dsa', 'diary'].indexOf(secMatch) !== -1 ? secMatch : '';
    var topCat = page.categories && page.categories.length ? page.categories.first().name : '';
    var kicker = (section ? __('pagehead.' + section + '.kicker') : '') + (section && topCat ? ' / ' : '') + (topCat || '');
    var postNo = post_no(page);
%>
<%# page head: same left-white / right-accent split as the list pages %>
<header class="pagehead pagehead--post">
    <div class="pagehead-main">
        <% if (kicker) { %><p class="pagehead-kicker"><%= kicker %></p><% } %>
        <h1 class="pagehead-title"><%- title_html(page.title) %></h1>
        <% if(theme.post_meta_enable){ %>
            <dl class="post-facts">
                <% if(theme.post_author_enable && config.author){ %>
                    <div class="post-fact post-author"><dt><%= __('author') %></dt><dd><a itemprop="author" rel="author" href="/"><%- config.author %></a></dd></div>
                <% } %>
                <% if(page.date && theme.post_date_enable){ %>
                    <div class="post-fact post-time"><dt><%= __('date') %></dt><dd><time datetime="<%= date_xml(page.date) %>"><%- date(page.date, 'YYYY.MM.DD') %></time></dd></div>
                <% } %>
                <% if(page.categories.length!==0 && theme.post_category_enable){ %>
                    <div class="post-fact post-category"><dt><%= __('category') %></dt><dd>
                        <% page.categories.forEach(function(item, i){ %><% if (i) { %><span class="cat-sep">/</span><% } %><a href="<%- url_for(taxonomy_path(item, page.lang)) %>"><%- item.name %></a><% }) %>
                    </dd></div>
                <% } %>
                <div class="post-fact post-reading-time"><dt><%= __('fact_read') %></dt><dd><%= reading_time(page) %> <%= __('min_unit') %></dd></div>
                <div class="post-fact post-views"><dt><%= __('fact_views') %></dt><dd><span class="supabase-views" data-path="<%- url_for(page.path) %>" data-supabase-record="<%- url_for(page.path) %>">–</span> <%= __('times_unit') %></dd></div>
                <% if (theme.pdf_enable && theme.supabase_url && !/^(https?:\/\/[^\/]+)?\/?diary\//.test(String(page.permalink || ''))) { %>
                <div class="post-fact post-download" hidden><dt><%= __('fact_download') %></dt><dd>
                    <%
                        // PDFs live in the public Supabase bucket "pdfs", at <post path without -en>/<zh|en>.pdf
                        var pdfLang = page.lang === 'en' ? 'en' : 'zh';
                        var pdfSlug = String(page.permalink || '').replace(/^https?:\/\/[^\/]+\//, '').replace(/\/$/, '').replace(/-en$/, '');
                        var pdfKey = '/' + pdfSlug + '/' + pdfLang + '.pdf';
                        // saved as "岳氏礦泉水-<title>.pdf" / "Yueswater-<title>.pdf"; characters filesystems reject are dropped
                        var pdfName = (pdfLang === 'en' ? 'Yueswater' : '岳氏礦泉水') + '-' + String(page.title).replace(/`/g, '').replace(/\$([^$]+)\$/g, '$1').replace(/\s*:\s*/g, ' - ').replace(/[\\/*?"<>|]/g, '').replace(/\s+/g, ' ').trim() + '.pdf';
                        // ?download=<name> makes Supabase send Content-Disposition, so the file is saved under that name
                        var pdfUrl = theme.supabase_url.replace(/\/$/, '') + '/storage/v1/object/public/pdfs/' + pdfSlug + '/' + pdfLang + '.pdf?download=' + encodeURIComponent(pdfName);
                    %>
                    <span class="post-download-count"><span class="supabase-views" data-path="<%- pdfKey %>">–</span> <%= __('times_unit') %></span>
                    <a class="post-download-btn" href="<%- pdfUrl %>" download="<%= pdfName %>" data-download-name="<%= pdfName %>" data-download-path="<%- pdfKey %>" data-toast="<%= __('toast_download') %>" title="<%= __('download_pdf') %>" aria-label="<%= __('download_pdf') %>">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"><path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/></svg>
                    </a>
                </dd></div>
                <% } %>
            </dl>
        <% } %>
    </div>
    <div class="pagehead-side" aria-hidden="true">
        <span class="pagehead-label">POST NO.</span>
        <span class="pagehead-big"><%= postNo %></span>
    </div>
</header>

<%# sharks swim beside the article (masked away from the text column) and along its floor %>
<canvas class="ascii-ocean ascii-ocean--gutter" aria-hidden="true"></canvas>

<div class="container post-layout">
    <%# toc %>
    <%if(theme.post_toc_enable && toc(page.content).length!==0){%>
        <%- partial('_partial/toc') %>
    <%}%>

    <%# article %>
    <article class="post-wrap">
        <div class="post-content">
            <%- page.content %>
        </div>

        <div class="post-share" data-url="<%- page.permalink %>" data-title="<%= plain_title(page.title) %>" data-toast-copied="<%= __('toast_copied') %>" data-toast-share="<%= __('toast_share') %>">
            <span class="post-share-label"><%= __('share') %></span>
            <a class="post-share-btn" href="https://social-plugins.line.me/lineit/share?url=<%- encodeURIComponent(page.permalink) %>" target="_blank" rel="noopener noreferrer" aria-label="LINE" title="LINE">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
            </a>
            <a class="post-share-btn" href="https://x.com/intent/post?url=<%- encodeURIComponent(page.permalink) %>&text=<%- encodeURIComponent(plain_title(page.title)) %>" target="_blank" rel="noopener noreferrer" aria-label="X" title="X">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
            </a>
            <button type="button" class="post-share-btn post-share-copy" aria-label="<%= __('copy_permalink') %>" title="<%= __('copy_permalink') %>">
                <svg class="icon-link" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" aria-hidden="true"><path fill="currentColor" d="M419.5 96c-16.6 0-32.7 4.5-46.8 12.7-15.8-16-34.2-29.4-54.5-39.5 28.2-24 64.1-37.2 101.3-37.2 86.4 0 156.5 70 156.5 156.5 0 41.5-16.5 81.3-45.8 110.6l-71.1 71.1c-29.3 29.3-69.1 45.8-110.6 45.8-86.4 0-156.5-70-156.5-156.5 0-1.5 0-3 .1-4.5 .5-17.7 15.2-31.6 32.9-31.1s31.6 15.2 31.1 32.9c0 .9 0 1.8 0 2.6 0 51.1 41.4 92.5 92.5 92.5 24.5 0 48-9.7 65.4-27.1l71.1-71.1c17.3-17.3 27.1-40.9 27.1-65.4 0-51.1-41.4-92.5-92.5-92.5zM275.2 173.3c-1.9-.8-3.8-1.9-5.5-3.1-12.6-6.5-27-10.2-42.1-10.2-24.5 0-48 9.7-65.4 27.1L91.1 258.2c-17.3 17.3-27.1 40.9-27.1 65.4 0 51.1 41.4 92.5 92.5 92.5 16.5 0 32.6-4.4 46.7-12.6 15.8 16 34.2 29.4 54.6 39.5-28.2 23.9-64 37.2-101.3 37.2-86.4 0-156.5-70-156.5-156.5 0-41.5 16.5-81.3 45.8-110.6l71.1-71.1c29.3-29.3 69.1-45.8 110.6-45.8 86.6 0 156.5 70.6 156.5 156.9 0 1.3 0 2.6 0 3.9-.4 17.7-15.1 31.6-32.8 31.2s-31.6-15.1-31.2-32.8c0-.8 0-1.5 0-2.3 0-33.7-18-63.3-44.8-79.6z"/></svg>
                <svg class="icon-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M434.8 70.1c14.3 10.4 17.5 30.4 7.1 44.7l-256 352c-5.5 7.6-14 12.3-23.4 13.1s-18.5-2.7-25.1-9.3l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l101.5 101.5 234-321.7c10.4-14.3 30.4-17.5 44.7-7.1z"/></svg>
            </button>
            <a class="post-coffee" href="https://buymeacoffee.com/yueswater" target="_blank" rel="noopener noreferrer">
                <img class="post-coffee-img" src="<%- url_for('/images/bmc-button.png') %>" alt="Buy me a coffee" height="40">
            </a>
        </div>
        <script>
            (function () {
                var btn = document.querySelector('.post-share-copy');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    var url = btn.closest('.post-share').getAttribute('data-url');
                    var done = function () {
                        btn.classList.add('copied');
                        setTimeout(function () { btn.classList.remove('copied'); }, 1500);
                        if (window.siteToast) window.siteToast(btn.closest('.post-share').getAttribute('data-toast-copied'));
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(url).then(done, function () {});
                    }
                });
            })();
            // LINE / X open the platform's share window in a new tab
            document.querySelectorAll('.post-share a.post-share-btn').forEach(function (a) {
                a.addEventListener('click', function () {
                    if (window.siteToast) window.siteToast(a.closest('.post-share').getAttribute('data-toast-share'));
                });
            });
        </script>

        <% if(theme.post_copyright_enable){ %>
            <section class="post-copyright">
                <% if(theme.post_copyright_author_enable){ %>
                    <p class="copyright-item">
                        <span><%= __('author') %>:</span>
                        <span><%- config.author %></span>
                    </p>
                <% } %>
                <% if(theme.post_copyright_permalink_enable){ %>
                    <p class="copyright-item permalink-item">
                        <span><%= __('permalink') %>:</span>
                        <span><a href="<%- page.permalink %>"><%- page.permalink %></a><button type="button" class="permalink-copy-btn" data-clipboard-text="<%- page.permalink %>" aria-label="<%= __('copy_permalink') %>"></button></span>
                    </p>
                <% } %>
                <% if(theme.post_copyright_license_enable){ %>
                    <p class="copyright-item">
                        <span><%= __('license') %>:</span>
                        <span><%- page.lang === 'en' ? theme.post_copyright_license_text_en : theme.post_copyright_license_text %></span>
                    </p>
                <% } %>
                <% if(theme.post_copyright_slogan_enable){ %>
                     <p class="copyright-item">
                         <span><%= __('slogan') %>:</span>
                         <span><%- theme.post_copyright_slogan_text %></span>
                     </p>
                <% } %>

            </section>
        <% } %>
        <section class="post-tags">
            <div>
                <span><%= __('tag_s') %>:</span>
                <span class="tag">
                    <% if(page.tags.length!==0){%>
                    <% page.tags.forEach(item=>{ %>
                        <a class="tag-badge" href="<%- url_for(taxonomy_path(item, page.lang)) %>"># <%- item.name %></a>
                    <% }) %>
                        <% } %>
                </span>
            </div>
            <div>
                <a href="javascript:window.history.back();"><%= __('back') %></a>
                <span>· </span>
                <a href="<%- config.root %>"><%= __('home') %></a>
            </div>
        </section>
        <%
            var langNav = lang_post_nav(page);
        %>
        <section class="post-nav">
            <% if(langNav.prev){ %>
                <a class="prev" rel="prev" href="<%- url_for(langNav.prev.path)%>"><%- title_html(langNav.prev.title)%></a>
            <% } %>
            <% if(langNav.next){ %>
            <a class="next" rel="next" href="<%- url_for(langNav.next.path)%>"><%- title_html(langNav.next.title)%></a>
            <% } %>
        </section>


    </article>
</div>

<div class="post-ocean" aria-hidden="true">
    <canvas class="ascii-ocean ascii-ocean--floor"></canvas>
</div>
<script src="<%- url_for('/js/widgets/ascii-ocean.js') %>?v=<%- build_version() %>" defer></script>
