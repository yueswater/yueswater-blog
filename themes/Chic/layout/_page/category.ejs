<%# single category page%>
<% var catCount = page.total_posts || 0; %>
<%- partial('_partial/pagehead', {
    kicker: __('pagehead.category.kicker'),
    title: escape_html(page.category),
    lead: __('pagehead.category.lead', catCount),
    label: __('pagehead.category.label'),
    big: catCount
}) %>
<div class="container container--bleed">
    <%- partial('archive', {pagination: config.category, index: true}) %>
</div>
