%>
<div class="container profile-container">
    <div class="intro">
        <div class="avatar">
            <a href="<%- url_for(articlesHref) %>"><img src="<%- url_for(theme.avatar) %>"></a>
        </div>
        <div class="nickname"><%- profileNickname %></div>
        <div class="description"><%- markdown(profileDescription) %></div>
        <div class="links">
            <% if (theme.links !== undefined) { %>
                <% for (var key in theme.links){ %>
                    <% var linkItem = theme.links[key]; %>
                    <% if (linkItem && linkItem.url) { %>
                        <a class="link-item" title="<%- key %>" href="<%= linkItem.url %>">
                            <% if(theme.links_text_enable) { %>
                                <%= key %>
                            <%}%>
                            <%if(theme.links_icon_enable && linkIcons[linkItem.icon]){ %>
                                <%- linkIcons[linkItem.icon] %>
                            <%}%>
                        </a>
                    <% } %>
                <% } %>
            <% } %>
        </div>
    </div>
</div>
