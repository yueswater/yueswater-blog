a, button, .menu-toggle, .menu-close, .theme-toggle label, .lang-switch, .link-item
  -webkit-tap-highlight-color: transparent

html
  font-family $font-family
  // The scrollbar track is see-through and shows this gradient, which turns footer-blue at the
  // bottom of the page, so the footer band does not stop short of the right edge.
  background linear-gradient(to bottom, $light-background-color calc(100% - 22rem), $light-accent-color calc(100% - 22rem))
  &:has(.dark-theme)
    background linear-gradient(to bottom, $dark-background-color calc(100% - 22rem), $light-accent-color calc(100% - 22rem))
  @media (max-width: 768px)
    background linear-gradient(to bottom, $light-background-color calc(100% - 37rem), $light-accent-color calc(100% - 37rem))
    &:has(.dark-theme)
      background linear-gradient(to bottom, $dark-background-color calc(100% - 37rem), $light-accent-color calc(100% - 37rem))
  &::-webkit-scrollbar
    width 8px
    height 8px

  // pages without a footer (home, about) keep a plain background
  &:not(:has(.footer))
    background $light-background-color
    &:has(.dark-theme)
      background $dark-background-color
  &::-webkit-scrollbar-track
    background transparent

  &::-webkit-scrollbar-thumb
    height 40px
    // translucent so it reads on the pale page and on the blue footer alike
    background-color rgba(0, 0, 0, 0.22)
    border-radius 16px
    &:hover
      background-color rgba(0, 0, 0, 0.36)

body
  font-size 16px
  font-weight normal
  line-height 1.7
  background-color $light-background-color
  color $light-font-color
  transition color 0.2s ease, border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease

  &:before
    content ""
    background-repeat no-repeat
    background-position center
    opacity 0.05
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    z-index -1

  &.dark-theme
    background-color $dark-background-color
    color $dark-font-color
    transition color 0.2s ease, border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease

::selection
  background-color $light-accent-color
  color #fff

.dark-theme ::selection
  background-color $dark-accent-color
  color #fff

a
  color $light-global-link-color
  text-decoration none
  transition color 0.2s ease, border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease
  cursor pointer

  &:hover
    color $light-global-link-hover-color
    text-decoration none
    transition color 0.2s ease, border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease
    
  .dark-theme &
    color $dark-global-link-color
    text-decoration none
    transition color 0.2s ease, border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease
    &:hover
      color $dark-global-link-hover-color
      text-decoration none
      transition color 0.2s ease, border-color 0.2s ease, background 0.2s ease, opacity 0.2s ease
