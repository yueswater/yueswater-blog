// 非衬线体 方正兰亭
@font-face
  font-family 'lanting'
  src: url('../fonts/lanting/lanting.eot'); /* IE9 */
  src: url('../fonts/lanting/lanting.eot?#iefix') format('embedded-opentype'), /* IE6-IE8 */ url('../fonts/lanting/lanting.woff2') format('woff2'),
          url('../fonts/lanting/lanting.woff') format('woff'),
          url('../fonts/lanting/lanting.ttf') format('truetype'); /* chrome, firefox, opera, Safari, Android, iOS 4.2+ */
  font-weight 300 700
  font-display swap

// lanting draws the apostrophe (U+2019, which the renderer turns ' into) and the hyphen
// as wide CJK-style glyphs ("I   m", "all - time"). Latin system fonts take just those
// code points (accented Latin letters too: the "ó" in "Corchón" was drawn wide as well).
// Curly double quotes stay with the CJK fonts on purpose (Chinese text).
@font-face
  font-family 'latin-punct'
  src: local('Helvetica Neue'), local('Arial'), local('Segoe UI'), local('Roboto')
  unicode-range: U+002D, U+0027, U+2019, U+00C0-00D6, U+00D8-00F6, U+00F8-024F

$font-family = 'latin-punct', 'lanting', Lantinghei SC, PingFang SC, 'Microsoft Jhenghei', Segoe UI, Microsoft Yahei, Arial

// lanting only ships as a single static weight; synthetic-bolding it
// per range gives inconsistent glyph coverage (some characters bold,
// some not). Bold text and headings (both default to bold) skip it
// and use the system CJK fonts, which have real bold weights.
$font-family-bold = Lantinghei SC, PingFang SC, 'Microsoft Jhenghei', Segoe UI, Microsoft Yahei, Arial

strong, b, h1, h2, h3, h4, h5, h6, th
  font-family $font-family-bold
  font-weight 600
