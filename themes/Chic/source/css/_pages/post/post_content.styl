// ---- article layout: toc rail | prose | spare ----
.main .container.post-layout
  display grid
  grid-template-columns minmax(0, 1fr) minmax(0, 44rem) minmax(0, 1fr)
  gap 0 unquote('clamp(24px, 4vw, 64px)')
  height auto
  max-width none
  padding unquote('clamp(32px, 4vw, 56px) clamp(16px, 4vw, 56px) clamp(48px, 6vw, 96px)')

.post-layout .post-wrap
  grid-column 2
  max-width none
  min-width 0
  padding 0

@media (max-width: 1279px)
  .main .container.post-layout
    grid-template-columns minmax(0, 1fr)
  .post-layout .post-wrap
    grid-column 1
    width 100%
    max-width 44rem
    margin 0 auto

.post-content
  padding-top 0
  margin 0
  text-align left
  font-size unquote('clamp(1.02rem, 0.96rem + 0.25vw, 1.125rem)')
  line-height 1.88
  letter-spacing 0.01em
  line-break strict

  p
    margin 0 0 1.25em
    // a lead-in line ("...:") hugs the list it introduces instead of leaving a blank line
    &:has(+ ul, + ol)
      margin-bottom 0.4em

  p + ul, p + ol
    margin-top 0
  > :first-child
    margin-top 0

  .headerlink
    display none

  h1, h2, h3, h4, h5, h6
    font-family $f-display
    font-weight 900
    text-wrap balance
    scroll-margin-top 6rem
    padding 0
    border 0
    themed(color, $light-ink, $dark-ink)

  // heading spacing is in rem on purpose: em would scale with each heading's own
  // font size and give h2 / h3 / h4 gaps that don't match
  h2
    margin 2.8rem 0 1.1rem
    font-size 1.62em
    line-height 1.3

  h3
    margin 2.2rem 0 0.9rem
    font-size 1.24em
    line-height 1.4
    &::before
      content ""
      display inline-block
      width 0.42em
      height 0.42em
      margin 0 0.55em 0.1em 0
      vertical-align middle
      themed(background, $light-accent-color, $dark-accent-color)

  h4
    margin 2rem 0 0.7rem
    font-size 1.05em

  h1::before
    content none

  // the body's 'lanting' webfont draws a very heavy bold; the system CJK fonts give a
  // medium-weight one
  strong, b
    font-family $f-body
    font-weight 600
    line-height 1
    themed(color, $light-ink, $dark-ink)

  li::marker
    font-family $f-mono
    font-size 0.85em
    themed(color, $light-accent-color, $dark-accent-color)

  // links: no underline, filled from the left on hover
  a
    text-decoration none
    background-repeat no-repeat
    background-position left
    background-size 0% 100%
    transition background-size 0.3s, color 0.2s
    themed(color, $light-post-link-color, $dark-accent-color)
    themed(background-image, linear-gradient($light-post-link-color, $light-post-link-color), linear-gradient($dark-accent-color, $dark-accent-color))

  a:hover
    background-size 100% 100%
    border-radius 0
    color #fff
    .dark-theme &
      color #0f1b2d

  // links that only wrap an image (e.g. inline logos) shouldn't get the
  // text-underline sweep -- there's no text for it to highlight
  a:has(img)
    background-image none
    text-decoration none

  hr
    width 5rem
    height 6px
    margin 3.5em auto
    border 0
    themed(background, linear-gradient(90deg, $light-ink 0 50%, $light-accent-color 50% 100%), linear-gradient(90deg, $dark-ink 0 50%, $dark-accent-color 50% 100%))

  blockquote:not([id^="fn_"])
    position relative
    display block
    margin 2em 0
    padding 1.1em 1.4em 1.1em unquote('calc(3rem + 1.2em)')
    font-size 1rem
    border 0
    themed(color, $light-ink-soft, $dark-ink-soft)
    themed(background-color, $light-code-background-color, $dark-post-blockquote-background-color)
    &::before
      content "\201C"
      position absolute
      left 0
      top 0
      bottom 0
      width 3rem
      display flex
      justify-content center
      padding-top 0.25em
      font-family $f-display
      font-size 2.6rem
      font-weight 900
      line-height 1
      color #f4f9fd
      background $row-fill
    p
      margin 0
    footer
      strong
        margin-right 0.5em
    &.pullquote
      background-color transparent

  table
    max-width 100%
    width 100%
    margin 2em 0
    border-collapse collapse
    font-size 0.92em
    thead th
      font-family $f-mono
      font-size 1em
      font-weight 600
      line-height 1.4
      letter-spacing 0.04em
      // a header stays on one line (font size untouched): the columns grow to fit it
      white-space nowrap
      text-align left
      color #fff
      background $row-fill
    th, td
      padding 0.7em 0.8em
      border 0
      themed(border-bottom, 1px solid $light-line, 1px solid $dark-line)

  // interval cell "807 至 991" (scripts/ciRange.js): the 至 lines up between rows
  .ci
    position relative
    display inline-block
    white-space nowrap
    font-variant-numeric tabular-nums
  .ci-lo, .ci-hi
    display inline-block
    min-width 5ch
  .ci-lo
    text-align right
  .ci-hi
    text-align left
  // a number in a centred column ("27.5 秒", "1.19"): the numbers share one box width and the
  // last digits line up; a unit hangs outside the box
  .num
    position relative
    display inline-block
    min-width 4ch
    text-align right
    white-space nowrap
    font-variant-numeric tabular-nums
    &[data-unit]::after
      content attr(data-unit)
      position absolute
      left 100%
      padding-left 0.3em
  // a unit after the interval hangs outside, so it does not shift the 至 of the rows without one
  .ci-unit
    position absolute
    left 100%

  // three-line table (scripts/tableDiv.js): rules on top, under the header and at the bottom only
  figure.tbl
    margin 2em 0
    figcaption
      margin 0 0 0.6em
    table
      margin 0
      border-top 2px solid currentColor
      border-bottom 2px solid currentColor
      thead th
        color inherit
        background none
        border-bottom 1px solid currentColor
        // the body cells are centred (the figure is), so the header is too; only the first column,
        // the row names, stays on the left
        text-align center
        &:first-child
          text-align left
      td
        border-bottom 0
        // a cell stays on one line ("< 0.001", "27.5 秒", an interval); the table scrolls on phones
        white-space nowrap
        padding-top 0.28em
        padding-bottom 0.28em
      // the figure is centred (caption.css) and its cells inherit that. The first column stays
      // on the left and is indented one character (a header character is 1em plus its 0.04em
      // letter-spacing), so the row names start under the second character of the header, 目 in 項目
      td
        &:first-child
          text-align left
          padding-left calc(0.8em + 1.04em)
    // second header line ({sub}): the rule goes under it, not under the first line
    table thead tr:not(:last-child) th
      border-bottom 0
      padding-bottom 0.25em
    // a thin rule under each "模型 X", a little shorter than its column
    table thead tr:not(:last-child) th:not(:first-child)
      background-image linear-gradient(currentColor, currentColor)
      background-repeat no-repeat
      background-position center bottom
      background-size calc(100% - 3em) 1px
    table thead tr.head-sub th
      padding-top 0.2em
      font-weight 400
    // thin rule above a row ({rule})
    table tbody tr.rule-above td
      border-top 1px solid currentColor
    // a coefficient and the standard error in the row under it (empty first cell) read as one block
    table tbody tr:has(+ tr > td:first-child:empty) td
      padding-bottom 0.1em
    table tbody tr:has(> td:first-child:empty) td
      padding-top 0
    // 註：a short line under the table; several notes become a small numbered list
    .tbl-note
      margin 0.6em 0 0
      // the renderer leaves an empty paragraph after the first line; its 1.25em margin made a gap
      p
        margin 0
      font-size 0.82em
      line-height 1.6
      text-align left
      opacity 0.85
      ol
        margin 0.2em 0 0
        padding-left 1.6em
      li
        margin 0
    .tbl-note-list:not(.tbl-note-lead) .tbl-note-label
      display block

  ul, ol
    margin 0 0 1.25em
  ul
    padding-left 2em
  // square bullets at every level (the browser default is disc, then circle). Drawn as a
  // box instead of ::marker so its size is ours and it sits on the middle of the first
  // line: the line is 1.88em tall, so the centre is 0.94em down.
  ul:not([class])
    list-style none
    > li
      position relative
      &::before
        content ''
        position absolute
        left -1.2em
        top 0.94em
        width 0.5em
        height 0.5em
        transform translateY(-50%)
        themed(background, $light-accent-color, $dark-accent-color)

  // display maths sit close to the text around them: 0.8em above and below (about one line gap), and the rows of
  // an aligned / align / gather block 0.5em apart. The paragraph in front gives up its own
  // 1.25em bottom margin (margins collapse, so the larger one would win), like a lead-in line
  // before a list. MathJax's own defaults (1em margin, 0.15em row padding as an inline style,
  // hence !important) are too loose against the page and too tight inside aligned blocks.
  p:has(+ div > mjx-container[display="true"])
    margin-bottom 0.8em
  mjx-container[jax="CHTML"][display="true"]
    margin 0.8em 0
  // double-click copies the LaTeX (js/post/math-copy.js): no word-selection flash, no focus
  // ring or border; hovering tints the formula in the accent colour
  mjx-container
    user-select none
    outline none
    border 0
    border-radius 0.3em
    transition background-color 0.2s
    &:hover
      themed(background-color, rgba(23, 71, 230, 0.08), rgba(90, 169, 255, 0.14))
  // "式 (3)" links already have their own hover fill
  a mjx-container:hover
    background-color transparent
  mjx-mtable[data-latex^="\\begin{align"], mjx-mtable[data-latex^="\\begin{split"], mjx-mtable[data-latex^="\\begin{gather"], mjx-mtable[data-latex^="\\begin{eqnarray"]
    > mjx-table > mjx-itable > mjx-mtr:not(:last-child) > mjx-mtd
      padding-bottom 0.5em !important

  .image-caption:not(:empty)
    min-width 20%
    max-width 80%
    display inline-block
    padding 10px
    margin 0 auto
    border-bottom 1px solid #d9d9d9
    font-size 14px
    color #969696
    line-height 1.7

  img
    display block
    max-width 100%
    height auto
    margin 0 auto
    overflow hidden
    // white-backed figures melt into the tinted page (light mode only)
    body:not(.dark-theme) &
      mix-blend-mode multiply

  // chart pairs (figureDiv.js): the transparent PNG drawn for the current theme is the one shown
  img.fig-dark
    display none
  .dark-theme &
    img.fig-light
      display none
    img.fig-dark
      display block

  // shields.io-style badges (e.g. project website/commits links) are meant
  // to sit inline in a row, not stack as full-width block images
  img[src*="shields.io"]
    display inline-block
    margin 0
    vertical-align middle

  img[data-action="zoom"]
    cursor zoom-in

  // LINE-sticker article's brand-icon tabsets (OS install, ImageMagick
  // install): icons inherit currentColor from the button text in
  // default/hover states, but the active state's forced white (#fff, see
  // tabset.css) should be #f3f3f3 instead -- scoped to this class so it
  // doesn't touch other pages' tabset icons (e.g. pip/poetry/uv)
  .brand-tabset .tabset-btn.active .tabset-icon
    fill #f3f3f3
  // this element is rendered by hexo.extend.tag.register()
  // location: scripts/image.js
  .image-box
    .image-box-title
      text-align center
      font-size .7em
      margin-top .5em
      margin-bottom 1em
      color $light-font-secondary-color
      .dark-theme &
        color $dark-font-secondary-color
  // end element

  // kramed renders footnote definitions ([^1]: ...) as <blockquote
  // id="fn_N">, which otherwise inherits the quote-box styling above --
  // wrong for a footnote. Reset to compact, unobtrusive footnote text.
  blockquote[id^="fn_"]
    display block
    margin 0.6em 0 0
    padding 0
    background-color transparent
    border-left none
    font-size 0.85em
    line-height 1.6
    color rgba(85, 85, 85, 0.75)
    .dark-theme &
      color $dark-font-secondary-color
    sup
      position static
      top auto
      font-size 1em
      line-height inherit
      vertical-align baseline
      margin-right 0
      font-weight 600
    a
      text-decoration none
    // only the back-link (↩) is set off from the text, not links written inside the note
    a[href^="#reffn_"]
      margin-left 0.3em

  blockquote#fn_1
    margin-top 2em
    padding-top 1em
    border-top 1px solid $light-border-color
    .dark-theme &
      border-top-color $dark-border-color
      max-width 45%
      border 0
      &.left
        float left
        text-align left
      &.right
        float right
        text-align right 

// a cell stays on one line ("教學文章" must not break into 教學文 / 章); a table wider than the text column scrolls
.post-content table
  th, td
    white-space nowrap

// phones: let long cell text wrap instead of widening the page
@media (max-width: 699px)
  .post-content table
    // headers do not wrap, so a wide table scrolls sideways instead of widening the page
    display block
    overflow-x auto
    th, td
      overflow-wrap anywhere
