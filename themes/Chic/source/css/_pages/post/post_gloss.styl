// Hover-gloss sentence (scripts/glossDiv.js): each word carries its meaning in data-gloss and shows it in a
// small bubble that pops up above the word; an accent underline draws itself in under the word at the same time.
.post-content .gloss
  margin 1.5em 0
  text-align center
  font-size 1.3em
  font-style italic
  line-height 2.6
  white-space nowrap   // a sentence stays on one line; phones shrink it (below) instead of wrapping

  .gloss-word
    position relative
    display inline-block
    margin 0 0.08em
    padding 0 0.12em
    line-height 1.5
    cursor help
    outline none
    border-bottom 1px dashed rgba(128, 128, 128, 0.55)
    background-image linear-gradient(currentColor, currentColor)
    background-repeat no-repeat
    background-position 0 100%
    background-size 0 2px
    transition background-size 0.3s ease, color 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)

    // the meaning bubble
    &::after
      content attr(data-gloss)
      position absolute
      left 50%
      bottom 100%
      z-index 5
      padding 0.2em 0.75em
      border-radius 8px
      font-size 0.62em
      font-style normal
      font-weight 600
      line-height 1.7
      white-space nowrap
      pointer-events none
      opacity 0
      transform translate(-50%, 4px) scale(0.8)
      transform-origin 50% 100%
      transition opacity 0.18s ease, transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1)
      themed(background, $light-accent-color, $dark-accent-color)
      themed(color, #fff, #0b1220)

    // the bubble's little tail
    &::before
      content ''
      position absolute
      left 50%
      bottom 100%
      z-index 5
      width 8px
      height 8px
      margin-bottom -2px
      pointer-events none
      opacity 0
      transform translate(-50%, 6px) rotate(45deg) scale(0.6)
      transition opacity 0.18s ease, transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1)
      themed(background, $light-accent-color, $dark-accent-color)

    &:hover, &:focus-visible
      transform translateY(-2px)
      background-size 100% 2px
      themed(color, $light-accent-color, $dark-accent-color)
      &::after
        opacity 1
        transform translate(-50%, -0.45em) scale(1)
      &::before
        opacity 1
        transform translate(-50%, -0.2em) rotate(45deg) scale(1)

@media (prefers-reduced-motion: reduce)
  .post-content .gloss .gloss-word
    &, &::before, &::after
      transition none

// narrow screens: scale the sentence with the viewport so the longest one still fits on one line
@media (max-width: 640px)
  .post-content .gloss
    font-size 4.3vw
    .gloss-word
      margin 0
      padding 0 0.06em
