// post page head: the list-page .pagehead in a compact flavour, plus the facts row
.pagehead--post
  grid-template-columns minmax(0, 1fr) 14rem
  min-height 0
  themed(border-bottom, 1.5px solid $light-ink, 1.5px solid $dark-line)
  .pagehead-main
    gap 1rem
    padding-top unquote('clamp(36px, 5vw, 64px)')
    padding-bottom unquote('clamp(24px, 3vw, 36px)')
  .pagehead-title
    font-size unquote('clamp(1.9rem, 3.4vw, 3.2rem)')
    line-height 1.18
    letter-spacing -0.01em
    text-wrap balance
  .pagehead-side
    padding 1.4rem 1.4rem 1.2rem
  .pagehead-big
    align-self flex-end
    font-size unquote('clamp(4.5rem, 8vw, 7rem)')

.dark-theme .pagehead-title
  color $dark-ink

// AUTHOR / DATE / CATEGORY / READ / VIEWS
.post-facts
  display grid
  grid-template-columns repeat(auto-fit, minmax(0, max-content))
  gap 0.9rem 2.6rem
  margin 0.4rem 0 0
  // same gap above and below, so the row sits in the middle between the rule and the panel edge
  padding-top unquote('clamp(24px, 3vw, 36px)')
  themed(border-top, 1px solid $light-line, 1px solid $dark-line)
  .post-fact
    display grid
    gap 0.3rem
    &[hidden]
      display none
  dt
    font-family $f-mono
    font-size 0.66rem
    font-weight 500
    line-height 1
    letter-spacing 0.14em
    text-transform uppercase
    themed(color, $light-muted, $dark-muted)
  dd
    margin 0
    font-family $f-mono
    font-size 0.95rem
    font-weight 600
    line-height 1.3
    font-variant-numeric tabular-nums
    themed(color, $light-ink, $dark-ink)
    a
      background none
      themed(color, $light-accent-color, $dark-accent-color)
      &:hover
        color #fff
        background $row-fill
    // the "/" between categories is its own element, so a link's hover fill stops at the text
    .cat-sep
      display inline-block
      margin 0 0.5em
      themed(color, $light-muted, $dark-muted)

// PDF download: "x 次" like the views, then a bare download icon that links to the file
.post-facts .post-download dd
  display flex
  align-items center
  gap 0.7rem
.post-facts .post-download-btn
  display inline-flex
  align-items center
  justify-content center
  width 1.5rem
  height 1.5rem
  margin -0.2rem 0
  border 0
  transition background 0.2s ease, color 0.2s ease
  svg
    width 16px
    height 16px
  &:hover
    color #fff
    background $row-fill

@media (max-width: 699px)
  .pagehead--post
    grid-template-columns minmax(0, 1fr)
    .pagehead-main
      padding-top 40px
    .pagehead-big
      font-size 4rem
  // two columns; the category list can run long, so it takes a full row
  .post-facts
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 0.9rem 1.2rem
    .post-category
      grid-column 1 / -1
    dd
      white-space nowrap
    .post-category dd
      white-space normal
