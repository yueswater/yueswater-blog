// Four-panel comic (scripts/comicDiv.js, layouts in scripts/lib/comic/): each panel a full-size figure cut
// to its polygon with clip-path, its image placed in the polygon's bounding box, and the panel borders drawn
// by one SVG on top (non-scaling stroke, so the line keeps its width at any size).
// The aspect-ratio and max-width below are only the square default layout's: every other layout sets its own
// inline style on the section (the default layout emits none, so existing posts render unchanged).
.post-content .comic
  position relative
  width 100%
  max-width 720px
  aspect-ratio 1 / 1
  margin 1.6em auto
  color inherit

  .comic-panel
    position absolute
    inset 0
    margin 0
    padding 0
    img
      position absolute
      display block
      margin 0
      max-width none
      object-fit cover
      // the page-wide rule that melts white-backed images into the tinted page would tint the scenes
      mix-blend-mode normal !important

  .comic-frame
    position absolute
    inset 0
    width 100%
    height 100%
    pointer-events none
    overflow visible
    polygon
      fill none
      stroke currentColor
      stroke-width 2.5px
      stroke-linejoin round
      vector-effect non-scaling-stroke
