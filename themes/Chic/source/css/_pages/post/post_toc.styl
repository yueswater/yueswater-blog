//// ========== TOC ========== //
// Left rail of the article layout (see .post-layout in post_content.styl). Hidden
// below 1280px by media.styl.

.post-toc
  grid-column 1
  justify-self end
  align-self start
  position sticky
  top calc(4.5rem + 32px)
  width unquote('min(16rem, 100%)')
  font-size 0.95rem
  // the site-wide 'lanting' webfont only has bold for some glyphs, which made the active
  // entry half bold; the system CJK fonts weight every glyph
  font-family $f-body

  &::before
    content "CONTENTS"
    display block
    margin 0 0 0.9rem 1.4rem
    font-family $f-mono
    font-size 0.72rem
    font-weight 500
    line-height 1
    letter-spacing 0.14em
    themed(color, $light-muted, $dark-muted)

  .tocbot-list
    position relative
    max-height calc(100vh - 4.5rem - 14rem)
    margin-left 0
    padding-right 0
    overflow auto
    themed(border-left, 3px solid $light-line, 3px solid $dark-line)
    &::-webkit-scrollbar
      width 0
    ul
      list-style none
      padding 0
      margin 0
      li
        margin 0
      li ul
        padding-left 0.9rem

  .toc-link
    display block
    margin-left -3px
    padding 0.32rem 0 0.32rem 1.1rem
    border-left 3px solid transparent
    line-height 1.5
    text-decoration none
    themed(color, $light-muted, $dark-muted)
    transition color 0.2s
    // tocbot's own rail marker
    &::before
      display none
    &:hover
      themed(color, $light-ink, $dark-ink)
    // inline code in a heading (apply_toc_overrides in toc.ejs copies it): monospace only, entry colour and no tint
    code
      font-family $f-mono
      font-size 0.9em
      color inherit
      background none
      padding 0

  .is-active-link
    font-weight 600
    themed(color, $light-accent-color, $dark-accent-color)
    themed(border-left-color, $light-accent-color, $dark-accent-color)

  .tocbot-list-menu
    margin 1.2rem 0 0 1.4rem
    font-family $f-mono
    font-size 0.85rem
    letter-spacing 0.06em
    a
      display flex
      align-items center
      gap 0.5rem
      margin 0.5rem 0
      cursor pointer
      themed(color, $light-muted, $dark-muted)
      .toc-btn-icon
        width 16px
        height 16px
        flex-shrink 0
      &:hover
        themed(color, $light-accent-color, $dark-accent-color)
