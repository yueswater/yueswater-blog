.post-copyright
  margin 1.5rem 0 0
  padding 1rem 0 0
  font-family $f-mono
  font-size 0.8rem
  line-height 1.9
  themed(border-top, 1px solid $light-line, 1px solid $dark-line)
  themed(color, $light-muted, $dark-muted)
  a
    themed(color, $light-post-link-color, $dark-accent-color)
    &:hover
      themed(color, $light-post-link-hover-color, $dark-post-link-hover-color)

  .copyright-item
    margin 5px 0
