// ---- definition / theorem / example callouts (see scripts/theoremDiv.js) ----
// Every callout opens with a badge strip on top that reads "定義：名稱" (body font). Three looks, all square-cornered like the rest of the bisect style:
//   .callout-definition  tinted block, blue bar on the left, brand-blue badge strip
//   .callout-theorem     (theorem, lemma, proposition and corollary share it) outlined box, brand-blue badge strip
//   .callout-example     the definition look in purple (tinted block, purple bar and badge strip)
// Text colour is inherited from the page in both themes (no forced colours, unlike the
// light-backed .admonition), so the dark theme only needs its own fills and rules.

// side padding in rem: the header band bleeds out by exactly this much, and an em would
// resolve against the label's smaller font size
$callout-px = 1.3rem

// the example callout: the definition look in purple
$callout-purple = #6d3fc9
$callout-purple-dark = #b79cff

.post-content .callout
  position relative
  margin 1.8em 0
  padding 0 $callout-px 1em
  border-radius 0
  line-height 1.8
  // a long formula or table scrolls inside the box instead of widening the page
  overflow-x auto

  > :last-child
    margin-bottom 0
  .callout-label + *
    margin-top 0

  // the badge strip: bleeds to the box edges, then the body starts one line below
  .callout-label
    display block
    margin 0 (-($callout-px)) 1em
    padding 0.5em $callout-px
    // body font, same as the text below
    font-family $f-body
    font-size 0.95rem
    font-weight 700
    line-height 1.6
    letter-spacing 0.02em
    color #fff

  // keep nested blocks compact and flush with the callout's own padding
  table
    margin 1em 0
  figure.highlight, pre
    margin 1em 0
  ul, ol
    margin-bottom 1em
  > ul:last-child, > ol:last-child
    margin-bottom 0

.post-content .callout-definition
  themed(background-color, $light-code-background-color, $dark-post-blockquote-background-color)
  themed(border-left, 4px solid $light-accent-color, 4px solid $dark-accent-color)
  .callout-label
    background $row-fill

.post-content .callout-theorem
  themed(border, 1.5px solid $light-accent-color, 1.5px solid $dark-accent-color)
  .callout-label
    background $row-fill

.post-content .callout-example
  themed(background-color, #f4f0fc, rgba(183, 156, 255, 0.1))
  themed(border-left, 4px solid $callout-purple, 4px solid $callout-purple-dark)
  .callout-label
    background $callout-purple

// proof: a "+ 顯示證明" fold, closed by default. After a statement it sits inside that callout; on its own it is a white box like an exercise (no badge strip: the statement
// above it already carries the badge).
.post-content .callout .proof-details
  summary
    cursor pointer
    list-style none
    user-select none
    font-family $f-mono
    font-size 0.74rem
    font-weight 600
    letter-spacing 0.1em
    themed(color, $light-accent-color, $dark-accent-color)
    &::-webkit-details-marker
      display none
    &::before
      content '+'
      display inline-block
      width 1.3em
  &[open] > summary::before
    content '\2212'
  .proof-body
    margin-top 0.7rem
    padding-top 0.7rem
    themed(border-top, 1px dashed $light-line, 1px dashed $dark-line)
    > :last-child
      margin-bottom 0

// inside a statement callout: just a little space under the statement
.post-content .callout:not(.callout-proof) .proof-details
  margin-top 1em

// on its own
.post-content .callout-proof
  padding 0.9rem 1.3rem
  line-height 1.8
  themed(background, #fff, rgba(255, 255, 255, 0.03))
  themed(border, 1px solid $light-line, 1px solid $dark-line)
