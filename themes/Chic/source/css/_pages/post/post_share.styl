.post-share
  display flex
  align-items center
  flex-wrap wrap
  gap 0.5rem
  margin-top 4rem
  padding-top 1.2rem
  line-height 1
  themed(border-top, 1.5px solid $light-ink, 1.5px solid $dark-line)
  .post-share-label
    margin-right 0.6rem
    font-family $f-mono
    font-size 0.66rem
    font-weight 500
    letter-spacing 0.14em
    text-transform uppercase
    themed(color, $light-muted, $dark-muted)
  .post-share-btn
    display inline-flex
    align-items center
    justify-content center
    width 36px
    height 36px
    padding 0
    border-radius 0
    background transparent
    cursor pointer
    transition background 0.2s ease, color 0.2s ease, border-color 0.2s ease
    themed(border, 1px solid $light-line, 1px solid $dark-line)
    themed(color, $light-ink, $dark-ink)
    svg
      width 16px
      height 16px
    &:hover
      color #fff
      border-color $row-fill
      background $row-fill
  .icon-check
    display none
  .post-share-copy.copied
    color #fff
    border-color $row-fill
    background $row-fill
    .icon-link
      display none
    .icon-check
      display block
.post-share .post-coffee
  display inline-flex
  margin-left auto
  line-height 0
  transition transform 0.15s ease, box-shadow 0.15s ease
  border-radius 9999px
  overflow hidden
  &:hover
    transform translateY(-1px)
    box-shadow 0 3px 8px rgba(0, 0, 0, 0.18)
  .post-coffee-img
    height 40px
    width auto

.post-share + script + .post-copyright
  margin-top 1.5rem
