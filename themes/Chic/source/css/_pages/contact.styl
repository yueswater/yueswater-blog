/** Contact page: custom form controls (fields, listbox select, counter, button, toast) **/
$cf-line = rgba(0, 0, 0, 0.16)
$cf-line-dark = rgba(255, 255, 255, 0.18)
$cf-error = #d93025
$cf-error-dark = #ff8a80

.contact-sea
  position relative
  overflow hidden
  // fainter fish here so labels stay readable when one swims past
  .ascii-ocean
    opacity 0.32
  > .container
    position relative
    z-index 1

.contact
  display grid
  grid-template-columns minmax(0, 1fr) 17rem
  gap 4rem
  box-sizing border-box
  width 100%
  max-width 60rem
  margin 0 auto
  padding 4rem 0 5rem
  @media (max-width: 860px)
    grid-template-columns 1fr
    gap 3rem

.cf
  display flex
  flex-direction column
  gap 1.4rem

.cf-row
  display grid
  grid-template-columns 1fr 1fr
  gap 1.25rem
  @media (max-width: 560px)
    grid-template-columns 1fr

.cf-field
  display flex
  flex-direction column
  gap 0.45rem
  min-width 0

.cf-label
  font-family $f-mono
  font-size 0.75rem
  font-weight 700
  letter-spacing 0.08em
  text-transform uppercase
  opacity 0.7

// shared box for text inputs, the textarea and the select trigger
.cf-input, .cf-select-trigger
  box-sizing border-box
  width 100%
  margin 0
  padding 0.7rem 0.85rem
  font inherit
  font-size 0.95rem
  color inherit
  border 1px solid
  themed(border-color, $cf-line, $cf-line-dark)
  border-radius 0
  themed(background, #fff, rgba(255, 255, 255, 0.04))
  outline none
  appearance none
  -webkit-appearance none
  transition border-color 0.15s, box-shadow 0.15s
  &::placeholder
    color inherit
    opacity 0.4
  &:hover
    themed(border-color, rgba(0, 0, 0, 0.32), rgba(255, 255, 255, 0.34))
  &:focus-visible
    themed(border-color, $light-accent-color, $dark-accent-color)
    box-shadow 0 0 0 3px rgba(23, 71, 230, 0.18)

.cf-field.is-invalid
  .cf-input, .cf-select-trigger
    themed(border-color, $cf-error, $cf-error-dark)
    &:focus-visible
      box-shadow 0 0 0 3px rgba(217, 48, 37, 0.16)

.cf-error
  min-height 1.1em
  margin 0
  font-size 0.8rem
  themed(color, $cf-error, $cf-error-dark)
  &:empty
    min-height 0

// select
.cf-select
  position relative

.cf-select-trigger
  display flex
  align-items center
  justify-content space-between
  gap 0.75rem
  text-align left
  cursor pointer

.cf-select-value.is-placeholder
  opacity 0.4

.cf-chevron
  width 1.05rem
  height 1.05rem
  flex-shrink 0
  opacity 0.6
  transition transform 0.2s

.cf-select.is-open .cf-chevron
  transform rotate(180deg)

.cf-select-list
  position absolute
  z-index 20
  top calc(100% + 0.35rem)
  left 0
  right 0
  margin 0
  padding 0.3rem
  list-style none
  border 1px solid
  themed(border-color, $cf-line, $cf-line-dark)
  themed(background, #fff, #16243a)
  box-shadow 0 12px 32px rgba(15, 27, 45, 0.16)
  animation cf-pop 0.14s ease-out

@keyframes cf-pop
  from
    opacity 0
    transform translateY(-4px)

.cf-option
  display flex
  align-items center
  justify-content space-between
  gap 1rem
  padding 0.6rem 0.7rem
  cursor pointer
  &.is-active
    themed(background, rgba(23, 71, 230, 0.07), rgba(90, 169, 255, 0.12))

.cf-option-text
  display flex
  flex-direction column
  gap 0.15rem

.cf-option-title
  font-size 0.92rem
  font-weight 600

.cf-option-hint
  font-size 0.78rem
  opacity 0.55

.cf-check
  width 1rem
  height 1rem
  flex-shrink 0
  opacity 0
  themed(color, $light-accent-color, $dark-accent-color)

.cf-option[aria-selected="true"] .cf-check
  opacity 1

// textarea + counter
.cf-textarea-wrap
  position relative

.cf-textarea
  display block
  min-height 9rem
  padding-bottom 2rem
  resize none
  line-height 1.7

.cf-count
  position absolute
  right 0.75rem
  bottom 0.55rem
  font-family $f-mono
  font-size 0.72rem
  opacity 0.45
  pointer-events none
  &.is-near
    opacity 1
    themed(color, $cf-error, $cf-error-dark)

.cf-trap
  position absolute
  left -9999px
  width 1px
  height 1px
  overflow hidden

// button
.cf-actions
  display flex
  align-items center
  flex-wrap wrap
  gap 1rem 1.5rem

.cf-button
  position relative
  display inline-flex
  align-items center
  justify-content center
  gap 0.6rem
  min-width 6rem
  padding 0.55rem 1.25rem
  font inherit
  font-size 0.9rem
  font-weight 700
  letter-spacing 0.06em
  color #fff
  border none
  border-radius 0
  themed(background, $light-accent-color, $dark-accent-color)
  cursor pointer
  transition transform 0.12s, filter 0.15s
  &:hover
    filter brightness(1.08)
  &:active
    transform translateY(1px)
  &:focus-visible
    outline 2px solid
    outline-offset 3px
    themed(outline-color, $light-accent-color, $dark-accent-color)
  &:disabled
    cursor progress
    filter saturate(0.6)
  .dark-theme &
    color $dark-background-color

.cf-spinner
  display none
  width 0.95rem
  height 0.95rem
  border 2px solid currentColor
  border-right-color transparent
  border-radius 50%
  animation cf-spin 0.7s linear infinite

.cf-button.is-busy .cf-spinner
  display inline-block

@keyframes cf-spin
  to
    transform rotate(360deg)

.cf-note
  margin 0
  font-size 0.8rem
  opacity 0.55

// side column
.contact-side
  display flex
  flex-direction column
  align-items center

// avatar peeking over a wooden board; the board carries the social links, a speech bubble sits above
.contact-peek
  position relative
  width 100%
  max-width 17rem
  margin 6rem 0 0
  img
    display block
    width 100%
    height auto
    user-select none
    pointer-events none

.contact-bubble
  position absolute
  bottom 88%
  left 20%
  width 80%
  aspect-ratio 200 / 110
  svg
    position absolute
    inset 0
    width 100%
    height 100%
    overflow visible
  path
    fill #fff
    stroke #111
    stroke-width 2.5
    stroke-linejoin round
    vector-effect non-scaling-stroke
  p
    position absolute
    top 8%
    left 9%
    right 9%
    height 62%
    display flex
    align-items center
    justify-content center
    margin 0
    font-family PingFang TC, PingFang SC, 'Microsoft Jhenghei', sans-serif
    font-size 0.8rem
    font-weight 600
    line-height 1.35
    text-align center
    text-wrap balance
    color #111

// the drawing's planks span y 37–57%, 58–77% and 78–97%; the links sit in one row on the middle plank
.contact-board
  position absolute
  top 58.5%
  left 7%
  right 7%
  height 18%
  display flex
  align-items center
  justify-content center
  .links
    display flex
    justify-content space-around
    width 100%
    gap 0
    margin 0
  .link-item
    display flex
    flex-direction column
    align-items center
    gap 0.2rem
    margin 0
    color #111
    &:hover
      color $light-accent-color
  .link-icon
    width 1.3rem
    height 1.3rem
  .link-label
    font-size 0.62rem
    line-height 1
    color #9aa0a8

// toast
.cf-toast
  position fixed
  z-index 50
  right 1.5rem
  bottom 1.5rem
  max-width unquote('min(22rem, calc(100vw - 3rem))')
  padding 0.9rem 1.1rem
  font-size 0.9rem
  color #fff
  border-left 4px solid
  box-shadow 0 12px 32px rgba(15, 27, 45, 0.25)
  opacity 0
  transform translateY(8px)
  transition opacity 0.2s, transform 0.2s
  &.is-shown
    opacity 1
    transform none
  &.is-ok
    background #0f1b2d
    border-color #3ccf8e
  &.is-warn
    background #0f1b2d
    border-color #ff8a7a

// message editor: tabs + toolbar above the textarea, preview in the same box
.cf-editor-bar
  display flex
  align-items flex-end
  justify-content space-between
  gap 0.75rem
  flex-wrap wrap
  margin-bottom -1px

.cf-tabs
  display flex

.cf-tab
  padding 0.45rem 0.9rem
  font inherit
  font-size 0.82rem
  color inherit
  border 1px solid transparent
  border-bottom none
  border-radius 0
  background transparent
  opacity 0.6
  cursor pointer
  &[aria-selected="true"]
    opacity 1
    font-weight 700
    themed(border-color, $cf-line, $cf-line-dark)
    themed(background, #fff, rgba(255, 255, 255, 0.04))
  &:focus-visible
    outline 2px solid $light-accent-color
    outline-offset -2px

.cf-tools
  display flex
  align-items center
  gap 0.1rem
  padding-bottom 0.25rem

.cf-tool
  display inline-flex
  align-items center
  justify-content center
  width 2rem
  height 2rem
  padding 0
  color inherit
  border none
  border-radius 0
  background transparent
  opacity 0.65
  cursor pointer
  svg
    width 1.05rem
    height 1.05rem
    fill none
    stroke currentColor
    stroke-width 1.8
    stroke-linecap round
    stroke-linejoin round
  &:hover, &:focus-visible
    opacity 1
    outline none
    themed(background, rgba(23, 71, 230, 0.08), rgba(90, 169, 255, 0.14))
    themed(color, $light-accent-color, $dark-accent-color)

.cf-tool-sep
  width 1px
  height 1.1rem
  margin 0 0.35rem
  themed(background, $cf-line, $cf-line-dark)

.cf-editor[data-mode="rich"] .cf-textarea
  display none

.cf-editor[data-mode="source"] .cf-rich
  display none

.cf-notes
  margin 0.6rem 0 0
  font-size 0.75rem
  line-height 1.6
  opacity 0.6
  ul
    margin 0
    padding-left 1.2em
    list-style square
  li::marker
    font-size 0.85em

// rendered markdown (form preview; the admin page has its own copy)
.md
  font-size 0.95rem
  line-height 1.7
  word-break break-word
  > :first-child
    margin-top 0
  > :last-child
    margin-bottom 0
  p, ul, pre
    margin 0 0 0.8em
  ul
    padding-left 1.3em
  code
    font-family $f-mono
    font-size 0.85em
    padding 0.1em 0.35em
    themed(background, rgba(0, 0, 0, 0.06), rgba(255, 255, 255, 0.1))
  pre
    padding 0.8em 1em
    overflow auto
    themed(background, rgba(0, 0, 0, 0.05), rgba(255, 255, 255, 0.07))
    code
      padding 0
      background none
  a
    themed(color, $light-accent-color, $dark-accent-color)
  .md-img
    display block
    max-width 100%
    max-height 22rem
    margin 0.4em 0
    border 1px solid
    themed(border-color, $cf-line, $cf-line-dark)
  .md-img-missing, .md-empty
    opacity 0.5

.visually-hidden
  position absolute
  width 1px
  height 1px
  margin -1px
  padding 0
  overflow hidden
  clip rect(0 0 0 0)
  white-space nowrap
  border 0
