.post-content
  padding-top 2rem
  text-align justify

  h2,
  h3,
  h4,
  h5,
  h6
    padding-top .8em
    padding-bottom .3em
  h4
    padding-bottom .05em
  h1::before
       content "#"
       margin-right 5px
       color $light-post-link-color
       .dark-theme &
         color $dark-accent-color
  h2::before
       content "#"
       margin-right 5px
       color $light-post-link-color
       .dark-theme &
         color $dark-accent-color

  h3::before
       content "|"
       margin-right 5px
       font-weight 900
       color $light-post-link-color
       .dark-theme &
         color $dark-accent-color

  a
    color $light-post-link-color
    background-image linear-gradient(to right, $light-post-link-color 50%, transparent 50%)
    background-size 200% 100%
    background-position right bottom
    background-repeat no-repeat
    transition background-position 0.25s ease, color 0.25s ease
    .dark-theme &
      color $dark-post-link-color
      background-image linear-gradient(to right, $dark-accent-color 50%, transparent 50%)

  a:hover
    background-position left bottom
    color #f3f3f3
    border-radius 0
    .dark-theme &
      color #f3f3f3

  code, pre
    padding 7px
    font-size 13px
    font-family Consolas, Monaco, Menlo, Consolas, monospace
  code
    padding 3px 5px
    border-radius 4px

  figure.highlight
    margin 1em 0
    overflow-x auto
    position relative
    &::-webkit-scrollbar
      width 6px
      height 6px
    &::-webkit-scrollbar-thumb
      width 6px
      background-color #eee
      border-radius 2px
    table
      position relative
    table, tr, td
      margin 0
      padding 0
      border 0
      width 100%
      border-collapse collapse
    .code
      pre
        margin 0 10px

    // line number
    .gutter
      width 10px
      color #d0d0d0
      pre
        margin 0


  ul
    padding-left 2em

  table
    max-width 100%
    width auto
    margin 10px auto
    border-spacing 0
    thead
      background $light-post-table-background-color
      .dark-theme &
        background $dark-post-table-background-color
    th, td
      padding 5px 15px
      border .5px solid $light-border-color


  .image-caption:not(:empty)
    min-width 20%
    max-width 80%
    display inline-block
    padding 10px
    margin 0 auto
    border-bottom 1px solid #d9d9d9
    font-size 14px
    color #969696
    line-height 1.7

  img
    display block
    max-width 100%
    height auto
    margin 0 auto
    overflow hidden

  // shields.io-style badges (e.g. project website/commits links) are meant
  // to sit inline in a row, not stack as full-width block images
  img[src*="shields.io"]
    display inline-block
    margin 0
    vertical-align middle

  img[data-action="zoom"]
    cursor zoom-in
  // this element is rendered by hexo.extend.tag.register()
  // location: scripts/image.js
  .image-box
    .image-box-title
      text-align center
      font-size .7em
      margin-top .5em
      margin-bottom 1em
      color $light-font-secondary-color
      .dark-theme &
        color $dark-font-secondary-color
  // end element

  blockquote
    font-size 1rem
    display block
    margin 1em 0
    padding 1em 1.2em 1em 1.2em
    position relative
    color rgba(#34495e, 0.8)
    background-color $light-post-blockquote-background-color
    border-left 2px solid $light-post-blockquote-border-color
    //box-shadow 1px 1px 2px rgba(0,0,0,0.125)
    p
      margin 0
    footer
      strong
        margin-right 0.5em
    .dark-theme &
      color $dark-font-color
      background-color $dark-post-blockquote-background-color
      border-left 2px solid $dark-post-blockquote-border-color
    &.pullquote
      background-color transparent

  // kramed renders footnote definitions ([^1]: ...) as <blockquote
  // id="fn_N">, which otherwise inherits the quote-box styling above --
  // wrong for a footnote. Reset to compact, unobtrusive footnote text.
  blockquote[id^="fn_"]
    display block
    margin 0.6em 0 0
    padding 0
    background-color transparent
    border-left none
    font-size 0.85em
    line-height 1.6
    color rgba(85, 85, 85, 0.75)
    .dark-theme &
      color $dark-font-secondary-color
    sup
      position static
      top auto
      font-size 1em
      line-height inherit
      vertical-align baseline
      margin-right 0.3em
      font-weight 600
    a
      margin-left 0.3em
      text-decoration none

  blockquote#fn_1
    margin-top 2em
    padding-top 1em
    border-top 1px solid $light-border-color
    .dark-theme &
      border-top-color $dark-border-color
      max-width 45%
      border 0
      &.left
        float left
        text-align left
      &.right
        float right
        text-align right 
