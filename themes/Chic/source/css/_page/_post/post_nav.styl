// previous / next: two big cells that fill with the accent on hover, like list rows
.post-nav
  display grid
  grid-template-columns 1fr 1fr
  margin-top 3rem
  themed(border-top, 1.5px solid $light-ink, 1.5px solid $dark-line)
  themed(border-bottom, 1px solid $light-line, 1px solid $dark-line)

  a.prev, a.next
    float none
    display flex
    flex-direction column
    gap 0.5rem
    padding 1.3rem 1.2rem
    font-family $f-display
    font-size 1rem
    font-weight 700
    line-height 1.5
    background linear-gradient($row-fill, $row-fill) no-repeat left / 0% 100%
    transition background-size 0.48s $row-ease, color 0.2s
    themed(color, $light-ink, $dark-ink)
    &:hover
      color #fff
      background-size 100% 100%
      transform none

  a.prev::before, a.next::after
    margin 0
    font-family $f-mono
    font-size 0.66rem
    font-weight 500
    line-height 1
    letter-spacing 0.14em
    transition color 0.2s
    themed(color, $light-muted, $dark-muted)
  a:hover::before, a:hover::after
    color rgba(255, 255, 255, 0.8)

  a.prev
    grid-column 1
    &::before
      content "← PREV"
  a.next
    grid-column 2
    text-align right
    &::after
      content "NEXT →"
      order -1

.tag:not(:last-child) a::after
  content " / "

// phones: stack previous / next
@media (max-width: 599px)
  .post-nav
    grid-template-columns minmax(0, 1fr)
    a.prev, a.next
      grid-column 1
      text-align left
