// previous / next: two big cells that fill with the accent on hover, like list rows
.post-nav
  display grid
  grid-template-columns 1fr 1fr
  margin-top 3rem
  themed(border-top, 1.5px solid $light-ink, 1.5px solid $dark-line)
  themed(border-bottom, 1px solid $light-line, 1px solid $dark-line)

  a.prev, a.next
    float none
    // not flex: the title is text plus inline <code>, and flex would turn each piece
    // into its own line. The PREV / NEXT label is pinned at the top instead.
    position relative
    // one line when it fits, never more than two (then cut with an ellipsis)
    display -webkit-box
    -webkit-box-orient vertical
    -webkit-line-clamp 2
    overflow hidden
    text-wrap balance
    padding 2.9rem 1.2rem 1.3rem
    font-family $f-display
    font-size 0.95rem
    font-weight 700
    line-height 1.5
    background linear-gradient($row-fill, $row-fill) no-repeat left / 0% 100%
    transition background-size 0.48s $row-ease, color 0.2s
    themed(color, $light-ink, $dark-ink)
    &:hover
      color #fff
      background-size 100% 100%
      transform none

  a.prev::before, a.next::after
    position absolute
    top 1.3rem
    left 1.2rem
    right 1.2rem
    margin 0
    font-family $f-mono
    font-size 0.66rem
    font-weight 500
    line-height 1
    letter-spacing 0.14em
    transition color 0.2s
    themed(color, $light-muted, $dark-muted)
  a:hover::before, a:hover::after
    color rgba(255, 255, 255, 0.8)

  a.prev
    grid-column 1
    &::before
      content "← PREV"
  a.next
    grid-column 2
    text-align right
    &::after
      content "NEXT →"

.tag:not(:last-child) a::after
  content " / "

// phones: stack previous / next
@media (max-width: 599px)
  .post-nav
    grid-template-columns minmax(0, 1fr)
    a.prev, a.next
      grid-column 1
      text-align left
