// ---- definition / theorem / example callouts (see scripts/theoremDiv.js) ----
// Three looks, all square-cornered and mono-labelled like the rest of the bisect style:
//   .callout-definition  tinted block, thick brand-blue bar on the left
//   .callout-theorem     (theorem, lemma and proposition share it) outlined box, blue header band
//   .callout-example     open block, dashed rule on the left, muted "//" label
// Text colour is inherited from the page in both themes (no forced colours, unlike the
// light-backed .admonition), so the dark theme only needs its own fills and rules.

// side padding in rem: the header band bleeds out by exactly this much, and an em would
// resolve against the label's smaller font size
$callout-px = 1.3rem

.post-content .callout
  position relative
  margin 1.8em 0
  padding 1em $callout-px
  border-radius 0
  line-height 1.8
  // a long formula or table scrolls inside the box instead of widening the page
  overflow-x auto

  > :last-child
    margin-bottom 0
  .callout-label + *
    margin-top 0

  .callout-label
    display block
    margin-bottom 0.6em
    font-family $f-mono
    font-size 0.78rem
    font-weight 600
    line-height 1.5
    letter-spacing 0.08em
    text-transform uppercase
    .callout-title
      font-weight 400
      letter-spacing 0.02em
      text-transform none

  // keep nested blocks compact and flush with the callout's own padding
  table
    margin 1em 0
  figure.highlight, pre
    margin 1em 0
  ul, ol
    margin-bottom 1em
  > ul:last-child, > ol:last-child
    margin-bottom 0

.post-content .callout-definition
  themed(background-color, $light-code-background-color, $dark-post-blockquote-background-color)
  themed(border-left, 4px solid $light-accent-color, 4px solid $dark-accent-color)
  .callout-label
    themed(color, $light-accent-color, $dark-accent-color)

.post-content .callout-theorem
  padding-top 0
  themed(border, 1.5px solid $light-ink, 1.5px solid $dark-line)
  .callout-label
    // header band, same fill and type as a table header
    margin 0 (-($callout-px)) 1em
    padding 0.5em $callout-px
    color #fff
    background $row-fill
    .callout-title
      color rgba(255, 255, 255, 0.82)

.post-content .callout-example
  padding-left 1.4rem
  themed(border-left, 2px dashed $light-muted, 2px dashed $dark-muted)
  .callout-label
    themed(color, $light-muted, $dark-muted)
    &::before
      content '// '
