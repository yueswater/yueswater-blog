// ---- definition / theorem / example callouts (see scripts/theoremDiv.js) ----
// Every callout opens with a badge strip on top that reads "定義：名稱" (body font). Three looks, all square-cornered like the rest of the bisect style:
//   .callout-definition  tinted block, blue bar on the left, brand-blue badge strip
//   .callout-theorem     (theorem, lemma and proposition share it) outlined box, dark badge strip
//   .callout-example     open block, dashed rule on the left, outlined muted badge strip
// Text colour is inherited from the page in both themes (no forced colours, unlike the
// light-backed .admonition), so the dark theme only needs its own fills and rules.

// side padding in rem: the header band bleeds out by exactly this much, and an em would
// resolve against the label's smaller font size
$callout-px = 1.3rem

.post-content .callout
  position relative
  margin 1.8em 0
  padding 0 $callout-px 1em
  border-radius 0
  line-height 1.8
  // a long formula or table scrolls inside the box instead of widening the page
  overflow-x auto

  > :last-child
    margin-bottom 0
  .callout-label + *
    margin-top 0

  // the badge strip: bleeds to the box edges, then the body starts one line below
  .callout-label
    display block
    margin 0 (-($callout-px)) 1em
    padding 0.5em $callout-px
    // body font, same as the text below
    font-family $f-body
    font-size 0.95rem
    font-weight 700
    line-height 1.6
    letter-spacing 0.02em
    color #fff

  // keep nested blocks compact and flush with the callout's own padding
  table
    margin 1em 0
  figure.highlight, pre
    margin 1em 0
  ul, ol
    margin-bottom 1em
  > ul:last-child, > ol:last-child
    margin-bottom 0

.post-content .callout-definition
  themed(background-color, $light-code-background-color, $dark-post-blockquote-background-color)
  themed(border-left, 4px solid $light-accent-color, 4px solid $dark-accent-color)
  .callout-label
    background $row-fill

.post-content .callout-theorem
  themed(border, 1.5px solid $light-ink, 1.5px solid $dark-line)
  .callout-label
    themed(background, $light-ink, $dark-line)

.post-content .callout-example
  padding-left 1.4rem
  themed(border-left, 2px dashed $light-muted, 2px dashed $dark-muted)
  .callout-label
    margin-left -1.4rem
    background transparent
    themed(color, $light-muted, $dark-muted)
    themed(border-bottom, 1px dashed $light-muted, 1px dashed $dark-muted)
