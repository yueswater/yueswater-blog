.post-share
  display flex
  align-items center
  gap 0.5rem
  margin-top 4rem
  line-height 1
  .post-share-label
    margin-right 0.25rem
    font-size 0.9em
    color $light-font-secondary-color
    .dark-theme &
      color $dark-font-secondary-color
  .post-share-btn
    display inline-flex
    align-items center
    justify-content center
    width 34px
    height 34px
    padding 0
    border 1px solid $light-border-color
    border-radius 50%
    background transparent
    color $light-font-color
    cursor pointer
    transition color 0.15s ease, border-color 0.15s ease
    .dark-theme &
      border-color $dark-border-color
      color $dark-font-color
    svg
      width 16px
      height 16px
    &:hover
      color $light-accent-color
      border-color $light-accent-color
      .dark-theme &
        color $dark-accent-color
        border-color $dark-accent-color
  .icon-check
    display none
  .post-share-copy.copied
    color $light-accent-color
    border-color $light-accent-color
    .icon-link
      display none
    .icon-check
      display block
.post-share .post-coffee
  display inline-flex
  margin-left auto
  line-height 0
  transition transform 0.15s ease, box-shadow 0.15s ease
  border-radius 8px
  &:hover
    transform translateY(-1px)
    box-shadow 0 3px 8px rgba(0, 0, 0, 0.18)
  .post-coffee-img
    height 40px
    width auto

.post-share + script + .post-copyright
  margin-top 1rem
