// post structure
.post-wrap
  p
    font-size 1em
    margin 1em 0 1em 0
  .post-header h1
    margin 0 !important

  .post-title
    font-size 2em
    line-height 1.5em

  .post-meta
    color rgba(85, 85, 85, 0.52941) !important
    .dark-theme &
      color $dark-font-secondary-color !important

    a
      color $light-post-link-color
      .dark-theme &
        color $dark-post-link-color

      &:hover
        color $light-post-link-hover-color
        .dark-theme &
          color $dark-post-link-hover-color

    .meta-icon
      width 0.9em
      height 0.9em
      vertical-align -0.05em
      margin-right 0.35em

    .post-meta-primary
      > span
        margin-right 1em
        &:last-child
          margin-right 0

      @media screen and (max-width: 1023px)
        .post-category
          display block
          margin-top 0.4em

    .post-meta-secondary
      margin-top 0.4em
      span
        margin-right 1em
        &:last-child
          margin-right 0
