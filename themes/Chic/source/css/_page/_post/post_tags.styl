.post-tags
  padding 1rem 0 1rem
  display flex
  justify-content space-between

  .tag-badge
    display inline-block
    margin 0 0.4em 0.4em 0
    padding 0.2em 0.8em
    border-radius 999px
    font-size 0.85em
    line-height 1.8
    background lighten($light-post-link-color, 88%)
    color $light-post-link-color
    transition background 0.15s ease, color 0.15s ease
    .dark-theme &
      background rgba($dark-accent-color, 0.15)
      color $dark-accent-color
    &:hover
      background $light-post-link-color
      color #fff
      .dark-theme &
        background $dark-accent-color
        color $dark-background-color
