.post-tags
  display flex
  align-items center
  justify-content space-between
  margin-top 1.5rem
  padding 0
  font-family $f-mono
  font-size 0.8rem
  font-weight 500
  letter-spacing 0.06em
  themed(color, $light-muted, $dark-muted)

  a
    color inherit
    transition color 0.2s ease
    &:hover
      themed(color, $light-accent-color, $dark-accent-color)

  .tag-badge
    display inline-block
    margin 0 0.5rem 0.4rem 0
    padding 0.4em 0.8em
    border-radius 0
    background transparent
    font-size 1em
    line-height 1.3
    letter-spacing 0
    transition background 0.2s ease, color 0.2s ease, border-color 0.2s ease
    themed(border, 1px solid $light-line, 1px solid $dark-line)
    themed(color, $light-ink-soft, $dark-ink-soft)
    &:hover
      color #fff
      border-color $row-fill
      background $row-fill
