/** Profile **/
.profile-container
  justify-content center
  align-items center
.intro
  text-align center
  .avatar
    padding 10px
    // The circle clips an enlarged copy of the image: the avatars are
    // bust shots whose flat bottom edge would otherwise show inside the
    // circle. scale + shift crops it away while keeping the head intact.
    a
      display inline-block
      vertical-align top
      width 128px
      height 128px
      overflow hidden
      -webkit-border-radius 100%
      border-radius 100%
      -webkit-box-shadow 0 0 0 0.3618em rgba(0, 0, 0, 0.05)
      box-shadow 0 0 0 0.3618em rgba(0, 0, 0, 0.05)
      -webkit-transition all ease 0.4s
      -moz-transition all ease 0.4s
      -o-transition all ease 0.4s
      transition all ease 0.4s
      cursor pointer
      &:hover
        position relative
        -webkit-transform translateY(-0.75em)
        -moz-transform translateY(-0.75em)
        -ms-transform translateY(-0.75em)
        -o-transform translateY(-0.75em)
        transform translateY(-0.75em)
    img
      display block
      width 100%
      height 100%
      -webkit-transform translateY(6%) scale(1.25)
      transform translateY(6%) scale(1.25)

.nickname
  font-size 2em
  font-weight normal

.links
  a
    padding: 0 5px
    &:hover
      background-color: transparent
  .link-icon
    width: 1.4em
    height: 1.4em
    vertical-align: middle
