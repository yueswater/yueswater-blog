// Empty section: centred in the space under the page head, set in the same type as the
// rest of the UI (mono kicker with a blue square, bold display line, quiet lead).
.section-empty
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 0.9rem
  min-height unquote('clamp(18rem, 46vh, 30rem)')
  padding 3rem $gx
  text-align center
  p
    margin 0

.section-empty-kicker
  display inline-flex
  align-items center
  gap 0.7em
  font-family $f-mono
  font-size 0.78rem
  font-weight 600
  letter-spacing 0.24em
  text-transform uppercase
  themed(color, $light-muted, $dark-muted)
  &::before
    content ""
    width 0.55em
    height 0.55em
    background $row-fill

.section-empty-title
  font-family $f-display
  font-size unquote('clamp(1.8rem, 4.2vw, 2.8rem)')
  font-weight 900
  font-stretch 112%
  line-height 1.15
  text-wrap balance
  themed(color, $light-ink, $dark-ink)

.section-empty-lead
  font-family $f-body
  font-size 0.98rem
  line-height 1.7
  max-width 28rem
  themed(color, $light-font-secondary-color, $dark-font-secondary-color)
