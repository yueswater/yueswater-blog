.section-posts
  margin-top 1.5em

.section-post-item
  display flex
  align-items flex-start
  gap 1.2em
  padding 1em 0
  border-bottom 1px solid $light-border-color
  color inherit
  .dark-theme &
    border-bottom-color $dark-border-color
  &:hover
    .section-post-title
      color $light-post-link-color
      .dark-theme &
        color $dark-accent-color

.section-post-thumb
  flex 0 0 100px
  width 100px
  height 70px
  overflow hidden
  border-radius 6px
  background #f2f2f2
  .dark-theme &
    background #3a3a3d
  img
    width 100%
    height 100%
    object-fit cover
    display block

.section-post-body
  flex 1 1 auto
  min-width 0

.section-post-title
  margin 0 0 0.4em
  font-size 1.1em
  font-weight 600
  line-height 1.4em
  transition color 0.15s ease
  overflow hidden
  text-overflow ellipsis
  display -webkit-box
  -webkit-line-clamp 2
  -webkit-box-orient vertical

.section-post-excerpt
  margin 0
  font-size 0.9em
  line-height 1.5em
  color rgba(85, 85, 85, 0.65)
  overflow hidden
  text-overflow ellipsis
  display -webkit-box
  -webkit-line-clamp 2
  -webkit-box-orient vertical
  .dark-theme &
    color $dark-font-secondary-color
