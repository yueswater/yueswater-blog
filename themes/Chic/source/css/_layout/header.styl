header
  user-select none
  .navbar-header
    display flex
    align-items center
    height 100%
  .site-logo-text
    line-height 1.2
    font-family $font-family-bold
    font-size 1.25rem
    font-weight 700
    letter-spacing 0.02em
  .menu
    display flex
    align-items center
.navbar .menu
    // bisect-style type (bold, one line); the hovered / current item just turns
    // the accent colour, no background
    gap 0.25rem
    .menu-item
      display inline-flex
      align-items center
      padding 0.7rem 0.9rem
      font-family $f-body
      font-size 0.95rem
      font-weight 700
      line-height 1.2
      white-space nowrap
      text-decoration none
      transition color 0.2s ease
      themed(color, $light-font-color, $dark-font-color)
      &:hover, &[aria-current='page']
        themed(color, $light-accent-color, $dark-accent-color)
    .lang-switch
      margin-left 1rem
    .theme-toggle
      margin-left 1rem
