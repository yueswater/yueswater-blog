// The footer is a solid accent-blue band with white type; a canvas of the same
// ASCII ocean as the rest of the site swims behind the text. The canvas is the
// raw engine output (light glyphs on black) screened onto the blue.
.footer
  box-sizing border-box
  position relative
  z-index 1
  width 100%
  margin-top 11rem
  padding 3rem $gx 1.5rem
  background-color $light-accent-color
  color rgba(255, 255, 255, 0.78)
  > .footer-inner, > .copyright
    position relative
    z-index 1
  // a soft blue halo keeps the type readable when a fish swims behind it
  .footer-name, .footer-tagline, .footer-col h2, .footer-col a, .copyright
    text-shadow 0 0 6px $light-accent-color, 0 0 12px $light-accent-color

.footer-ocean
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  overflow hidden
  pointer-events none

.ascii-ocean.ascii-ocean--footer
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  z-index 0
  opacity 0.55
  filter none
  mix-blend-mode screen
  .dark-theme &
    filter none
    mix-blend-mode screen

.footer-inner
  max-width 64rem
  margin 0 auto
  display flex
  justify-content space-between
  align-items flex-start
  gap 3rem
  text-align left

.footer-name
  font-family $f-body
  font-size 1.35rem
  font-weight 800
  color #fff
  text-decoration none

.footer-tagline
  margin 0.5rem 0 1rem
  font-size 0.95rem
  font-weight 500
  line-height 1.5

.footer-brand .links
  display flex
  gap 0.9rem
  .link-item
    color #fff
    opacity 0.85
    transition opacity 0.2s ease
    &:hover
      opacity 1

.footer-cols
  display flex
  gap 4rem

.footer-col
  h2
    margin 0 0 0.9rem
    font-family $f-body
    font-size 0.85rem
    font-weight 800
    letter-spacing 0.08em
    text-transform uppercase
    color #fff
  ul
    list-style none
    margin 0
    padding 0
  li
    margin-bottom 0.5rem
    line-height 1.4
  a
    color #fff
    text-decoration none
    font-family $f-body
    font-size 0.95rem
    font-weight 600
    opacity 0.92
    transition opacity 0.2s ease
    &:hover
      opacity 1
      text-decoration underline

.copyright
  max-width 64rem
  margin 2.5rem auto 0
  padding-top 1.25rem
  border-top 1px solid rgba(255, 255, 255, 0.25)
  font-size 14px
  line-height 1.6
  text-align left
  a
    color #fff

@media (max-width: 768px)
  .footer-inner
    flex-direction column
    gap 2rem
  .footer-cols
    flex-wrap wrap
    gap 2rem 3rem

// the character leaning on the footer's top edge. Sizes are fractions of the source image
// (1024 x 1536): the body shows down to the footer edge (y = 38.5%); the second copy shows only the
// forearm and hand, so the arm rests over the edge in front of the blue band.
.footer-peek
  // Everything is a fraction of the figure's width (--peek-w): the sink below the footer edge scales with
  // the figure, so it stays lined up with the cut lines in the image (given as % of the image) at any
  // size or zoom. A fixed rem offset would drift when the figure shrinks on small screens.
  --peek-w 13rem
  position absolute
  bottom calc(100% - var(--peek-w) * 0.0385)
  left max($gx, calc(50% - 32rem))
  width var(--peek-w)
  pointer-events none
  user-select none
  z-index 2
  img
    position absolute
    top 0
    left 0
    width 100%
    height auto
    max-width none
  .footer-peek-body
    clip-path inset(0 0 61.6% 0)
  .footer-peek-hand
    // forearm and hand (y 500-740 of the source; the left edge follows the outside of the forearm's lower corner so none of the shirt shows): they lie in front of the blue band, the torso stays behind it
    clip-path polygon(43.8% 32.6%, 81.1% 32.6%, 81.1% 48.2%, 67.4% 48.2%, 67.4% 40.9%, 47.5% 40.9%, 45.4% 39.8%, 44.7% 38.5%)
  // the body copy only needs its visible part to take up space
  &::before
    content ''
    display block
    padding-bottom 61.5%

@media (max-width: 768px)
  .footer-peek
    --peek-w 9rem
