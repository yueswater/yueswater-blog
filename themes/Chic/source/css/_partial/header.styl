header
  user-select none
  .navbar-header
    display flex
    align-items center
    height 100%
  .site-logo-text
    line-height 1.2
    font-family $font-family-bold
    font-size 1.25rem
    font-weight 700
    letter-spacing 0.02em
  .menu
    display flex
    align-items center
.navbar .menu
    // modeled on techblog.lycorp.co.jp: 14px bold items, 2px underline sweeping in on hover
    .menu-item
      padding 0 1.2vw
      font-family $font-family-bold
      font-size 14px
      font-weight 500
      letter-spacing 0.03em
      line-height 20px
      display inline-flex
      align-items center
      white-space nowrap
      color $light-font-color
      .dark-theme &
        color $dark-font-color
      span
        display inline-block
        position relative
        &:before
          content ""
          position absolute
          bottom -6px
          left 0
          width 100%
          height 2px
          background-color $light-accent-color
          .dark-theme &
            background-color $dark-accent-color
          transform scaleX(0)
          transition transform 0.4s cubic-bezier(.645,.045,.355,1)
      &:hover
        color $light-accent-color
        .dark-theme &
          color $dark-accent-color
        span:before
          transform scaleX(1)
    .lang-switch
      margin-left 1.2vw
    .theme-toggle
      margin-left 1.2vw
