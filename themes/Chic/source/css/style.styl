// Single stylesheet entry. Everything lives in underscore-prefixed folders so Hexo
// compiles only this file; the order below is the cascade order.

// base: variables, reset, fonts, element defaults
@import '_base/variable.styl';
@import '_base/normalize.styl';
@import '_base/font.styl';
@import '_base/base.styl';

// layout: page skeleton and site chrome
@import '_layout/layout.styl';
@import '../fonts/iconfont/iconfont.css';
@import '_components/checkbox.styl';
@import '_layout/header.styl';
@import '_layout/footer.styl';
@import '_layout/paginator.styl';

// pages
@import '_pages/profile.styl';
@import '_pages/ascii-ocean.styl';
@import '_pages/post-rows.styl';
@import '_pages/pagehead.styl';
@import '_pages/taxonomy-index.styl';
@import '_pages/transition.styl';
@import '_pages/archive.styl';
@import '_pages/category.styl';
@import '_pages/tag.styl';
@import '_pages/page.styl';
@import '_pages/section.styl';
@import '_pages/about.styl';

// post page
@import '_pages/post/post_header.styl';
@import '_pages/post/post_content.styl';
@import '_pages/post/post_callout.styl';
@import '_pages/post/post_table_fold.styl';
@import '_pages/post/post_fold.styl';
@import '_pages/post/post_copyright.styl';
@import '_pages/post/post_share.styl';
@import '_pages/post/post_code.styl';
@import '_pages/post/post_exercises.styl';
@import '_pages/post/post_tags.styl';
@import '_pages/post/post_nav.styl';
@import '_pages/post/post_toc.styl';

// vendor
@import '_vendor/tocbot.css';

// responsive overrides
@import '_layout/media.styl';

// code-block style (navy in both themes)
